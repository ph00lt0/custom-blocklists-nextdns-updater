name: Update NextDNS Denylist

on:
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  update-denylist:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install nextdnsctl
        run: pip install nextdnsctl

      - name: Update denylist for all accounts
        env:
          NEXTDNS_ACCOUNT_1_API_KEY: ${{ secrets.NEXTDNS_ACCOUNT_1_API_KEY }}
          NEXTDNS_ACCOUNT_2_API_KEY: ${{ secrets.NEXTDNS_ACCOUNT_2_API_KEY }}
          NEXTDNS_ACCOUNT_3_API_KEY: ${{ secrets.NEXTDNS_ACCOUNT_3_API_KEY }}
          NEXTDNS_ACCOUNT_4_API_KEY: ${{ secrets.NEXTDNS_ACCOUNT_4_API_KEY }}
          NEXTDNS_ACCOUNT_5_API_KEY: ${{ secrets.NEXTDNS_ACCOUNT_5_API_KEY }}
        run: |
          LISTS_FILE="blocklists.txt"

          if [ ! -f "$LISTS_FILE" ]; then
            echo "::error::Blocklists file not found: $LISTS_FILE"
            echo "Create it with one blocklist URL per line."
            exit 1
          fi

          url_count=$(grep -cv '^\s*$\|^\s*#' "$LISTS_FILE")
          if [ "$url_count" -eq 0 ]; then
            echo "::error::No URLs found in $LISTS_FILE"
            exit 1
          fi
          echo "Found $url_count blocklist URL(s) in $LISTS_FILE"

          TEMP_DIR=$(mktemp -d)
          trap 'rm -rf "$TEMP_DIR"' EXIT

          COMBINED_RAW="$TEMP_DIR/blocklist_combined_raw.txt"
          touch "$COMBINED_RAW"

          # Download each blocklist URL and merge
          url_index=1
          while IFS= read -r url || [ -n "$url" ]; do
            # Skip empty lines and comments
            url=$(echo "$url" | sed 's/[[:space:]]*$//' | sed 's/^[[:space:]]*//')
            [ -z "$url" ] && continue
            case "$url" in \#*) continue;; esac

            echo ""
            echo "Downloading blocklist $url_index: $url"
            if curl -sfL "$url" -o "$TEMP_DIR/source_$url_index.txt"; then
              lines=$(wc -l < "$TEMP_DIR/source_$url_index.txt")
              echo "  ✓ Downloaded ($lines lines)"
              cat "$TEMP_DIR/source_$url_index.txt" >> "$COMBINED_RAW"
            else
              echo "  ::error::Failed to download: $url"
              exit 1
            fi
            url_index=$((url_index + 1))
          done < "$LISTS_FILE"

          echo ""
          echo "Combined raw blocklist: $(wc -l < "$COMBINED_RAW") total lines"

          # Normalize: strip inline comments, trim whitespace, drop empty lines, sort+dedup
          CLEAN_FILE="$TEMP_DIR/blocklist_clean.txt"
          sed 's/#.*//' "$COMBINED_RAW" \
            | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
            | grep -v '^$' \
            | sort -u > "$CLEAN_FILE"

          CLEAN_COUNT=$(wc -l < "$CLEAN_FILE")
          echo "✓ Normalized combined blocklist: $CLEAN_COUNT unique domains"

          account_num=1
          total_failed=0

          while true; do
            secret_name="NEXTDNS_ACCOUNT_${account_num}_API_KEY"
            api_key_value=${!secret_name}

            if [ -z "$api_key_value" ]; then
              echo "No more accounts found (checked up to account $((account_num - 1)))"
              break
            fi

            echo ""
            echo "================================"
            echo "Processing account $account_num"
            echo "================================"

            export NEXTDNS_API_KEY="$api_key_value"

            echo "Fetching all profiles for account $account_num..."
            profiles=$(nextdnsctl profile-list 2>/dev/null | grep -oP '^[a-z0-9]+(?=:)' | grep -v '^$')

            if [ -z "$profiles" ]; then
              echo "::warning::No profiles found for account $account_num"
              account_num=$((account_num + 1))
              continue
            fi

            echo "Found profiles:"
            echo "$profiles"
            echo ""

            account_failed=0

            for profile in $profiles; do
              echo "--- Profile: $profile ---"

              # Step 1: Export current denylist and find stale entries
              echo "Exporting current denylist..."
              if nextdnsctl denylist export "$profile" 2>/dev/null \
                | sed 's/#.*//' \
                | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
                | grep -v '^$' \
                | sort -u > "$TEMP_DIR/current_${profile}.txt"; then

                STALE_FILE="$TEMP_DIR/stale_${profile}.txt"
                comm -23 "$TEMP_DIR/current_${profile}.txt" "$CLEAN_FILE" > "$STALE_FILE"

                stale_count=$(wc -l < "$STALE_FILE")

                if [ "$stale_count" -gt 0 ]; then
                  echo "Found $stale_count stale domain(s) to remove"
                  if xargs -r nextdnsctl denylist remove "$profile" < "$STALE_FILE" 2>&1; then
                    echo "✓ Removed $stale_count stale domain(s)"
                  else
                    echo "::warning::Some stale domains may not have been removed for profile $profile"
                  fi
                else
                  echo "No stale domains found"
                fi
              else
                echo "::warning::Failed to export denylist for profile $profile, skipping cleanup"
              fi

              # Step 2: Import (delta-aware, only adds missing domains)
              echo "Importing blocklist..."
              if nextdnsctl denylist import "$profile" "$COMBINED_RAW" 2>&1; then
                echo "✓ Import completed for profile: $profile"
              else
                echo "✗ Failed to import for profile: $profile"
                account_failed=1
                total_failed=1
              fi
              echo ""
            done

            if [ $account_failed -eq 0 ]; then
              echo "✓ All profiles updated successfully for account $account_num!"
            else
              echo "✗ Some profiles failed for account $account_num"
            fi

            account_num=$((account_num + 1))
          done

          echo ""
          echo "================================"
          echo "Update cycle complete"
          echo "================================"

          if [ $total_failed -eq 1 ]; then
            echo "::error::Some accounts had failures"
            exit 1
          fi

          echo "✓ All accounts processed successfully!"
